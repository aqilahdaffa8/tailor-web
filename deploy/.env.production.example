APP_NAME="Tailor Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Database MySQL 8+ Wajib (Menggunakan Stored Procedure, Stored Function, & Triggers)
# SQLite tidak didukung.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tailor_production
DB_USERNAME=tailor_user
DB_PASSWORD=your_strong_database_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Keamanan Reverse Proxy (Daftar IP proxy terpercaya dipisahkan koma, misal: 127.0.0.1 jika di belakang Nginx lokal)
TRUSTED_PROXIES=127.0.0.1

# Masa aktif Token Sanctum untuk aplikasi mobile (dalam menit).
# Contoh: 10080 untuk 7 hari, 43200 untuk 30 hari. Kosongkan / default null jika tidak ingin kedaluwarsa.
SANCTUM_TOKEN_EXPIRATION=10080

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
